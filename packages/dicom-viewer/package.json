        "react-resize-detector": "^12.1.0"
    },
    "devDependencies": {
        "@cornerstonejs/core": "^4.15.24",
        "@cornerstonejs/dicom-image-loader": "^4.15.24",
        "@cornerstonejs/tools": "^4.15.24",
        "@mantine/core": "^7.15.3",
        "@tabler/icons-react": "^3.22.0",
        "@types/react": "^18",
        "@types/react-dom": "^18",
        "@vitejs/plugin-react": "^5.2.0",
        "react": "^18",
        "react-dom": "^18",
